# Required for protected backend calls
OWNER_API_KEY=replace-with-strong-random-value

# API health endpoint used by `make verify`
API_HEALTH_URL=http://localhost:8000/health

# PostgreSQL DSN used by app and verification
DATABASE_URL=postgresql://mood:mood@localhost:5432/mood

# Optional for current verification script, required by planned stack
REDIS_URL=redis://localhost:6379/0

# Feature extraction contract version for feature-set metadata
FEATURE_EXTRACTOR_VERSION=v1

# Fitbit OAuth (required for /fitbit/oauth endpoints)
FITBIT_CLIENT_ID=replace-with-fitbit-client-id
FITBIT_CLIENT_SECRET=replace-with-fitbit-client-secret
FITBIT_REDIRECT_URI=http://localhost:8000/fitbit/oauth/callback
FITBIT_OAUTH_SCOPE=activity heartrate sleep nutrition oxygen_saturation respiratory_rate temperature profile
FITBIT_SUBSCRIBER_ID=1

# Fitbit webhook ingestion
FITBIT_WEBHOOK_SECRET=replace-with-fitbit-webhook-secret
FITBIT_WEBHOOK_COALESCE_SECONDS=10

# Fitbit fetch anchoring + rate limits
FITBIT_DEFAULT_TIMEZONE=UTC
NIGHT_ANCHOR_START_HOUR=18
NIGHT_ANCHOR_END_HOUR=12
FITBIT_MIN_FETCH_INTERVAL_SECONDS=0.2
FITBIT_MAX_RETRIES=2
FITBIT_BACKOFF_BASE_SECONDS=0.5
FITBIT_MAX_CONCURRENT_FETCHES=3
FITBIT_FORBIDDEN_CACHE_SECONDS=3600

# Weather/AQ cache for context enrichment
WEATHER_CACHE_TTL_SECONDS=900
